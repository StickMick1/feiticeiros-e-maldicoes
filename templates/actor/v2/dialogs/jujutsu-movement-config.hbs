<section class='jj-rd-config'>
    <header class='jj-rd-config-header'>
        <h2>Deslocamento</h2>
        <p>Base fixa: {{movement.base}} m. O bônus será somado ao salvar.</p>
    </header>
    <div class='jj-rd-config-list'>
        <label class='jj-rd-config-value'>
            <span>Bônus (m)</span>
            <input type='number' step='any' inputmode='decimal' name='movementBonus' value='{{movement.bonus}}' />
        </label>
    </div>
</section>