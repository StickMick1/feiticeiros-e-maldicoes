                                                        <option value='{{opt.key}}' {{#if (eq opt.key ../jujutsu.props.specializationCd.attribute)}}selected{{/if}}>{{opt.label}}</option>
                                                    {{/each}}
                                                </select>
                                            </label>
                                            <label class='jj-derived-row'>
                                                <span>Mod. Atr.</span>
                                                <input type='number' value='{{jujutsu.computed.cdAttrMod}}' readonly />
                                            </label>
                                            <label class='jj-derived-row'>
                                                <span>Treino</span>
                                                <input name='system.props.specializationCd.treino' type='number' data-dtype='Number' value='{{jujutsu.props.specializationCd.treino}}' />
                                            </label>
                                            <label class='jj-derived-row'>
                                                <span>Outros</span>
                                                <input name='system.props.specializationCd.others' type='number' data-dtype='Number' value='{{jujutsu.props.specializationCd.others}}' />
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class='jj-secondary-split'>
                                <div class='jj-card jj-derived-card'>
                                    <h3>Testes de Morte</h3>
                                    <div class='jj-derived-body'>
                                        <div class='jj-derived-total-grid'>
                                            <div class='jj-derived-total'>
                                                <span>Sucessos</span>
                                                <input type='number' value='{{jujutsu.computed.deathSuccessCount}}' data-death-count='successes' readonly />
                                            </div>
                                            <div class='jj-derived-total'>
                                                <span>Falhas</span>
                                                <input type='number' value='{{jujutsu.computed.deathFailureCount}}' data-death-count='failures' readonly />
                                            </div>
                                        </div>
                                        <div class='jj-death-track-grid'>
                                            <div class='jj-death-track'>
                                                <span>Sucessos</span>
                                                <div class='jj-death-pips'>
                                                    {{#each jujutsu.deathSuccesses as |isChecked idx|}}
                                                        <label class='jj-death-pip jj-checkbox jj-checkbox--compact {{#if isChecked}}is-checked{{/if}}'>
                                                            <input
                                                                class='jj-checkbox-input'
                                                                name='system.props.deathTests.successes.{{idx}}'
                                                                type='checkbox'
                                                                data-death-track='successes'
                                                                data-death-index='{{idx}}'
                                                                {{checked isChecked}}
                                                            />
                                                            <span class='jj-checkbox-mark' aria-hidden='true'></span>
                                                        </label>
                                                    {{/each}}
                                                </div>
                                            </div>
                                            <div class='jj-death-track'>
                                                <span>Falhas</span>
                                                <div class='jj-death-pips'>
                                                    {{#each jujutsu.deathFailures as |isChecked idx|}}
                                                        <label class='jj-death-pip jj-checkbox jj-checkbox--compact {{#if isChecked}}is-checked{{/if}}'>
                                                            <input
                                                                class='jj-checkbox-input'
                                                                name='system.props.deathTests.failures.{{idx}}'
                                                                type='checkbox'
                                                                data-death-track='failures'
                                                                data-death-index='{{idx}}'
                                                                {{checked isChecked}}
                                                            />
                                                            <span class='jj-checkbox-mark' aria-hidden='true'></span>
                                                        </label>
                                                    {{/each}}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class='jj-card jj-derived-card'>
                                    <h3>Dados de Vida</h3>
                                    <div class='jj-derived-body'>
                                        <div class='jj-derived-total-grid'>
                                            <div class='jj-derived-total'>
                                                <span>Disp.</span>
                                                <input type='number' value='{{jujutsu.computed.hitDiceAvailableTotal}}' readonly />
                                            </div>
                                            <div class='jj-derived-total'>
                                                <span>Gastos</span>
                                                <input type='number' value='{{jujutsu.computed.hitDiceSpentTotal}}' readonly />
                                            </div>
                                        </div>
                                        <div class='jj-hit-dice-list'>
                                            <div class='jj-hit-dice-header'>
                                                <span></span>
                                                <span>Gastos</span>
                                                <span>Disp.</span>
                                            </div>
                                            <div class='jj-hit-dice-row'>
                                                <span class='jj-hit-dice-die'>d8</span>
                                                <input name='system.props.hitDice.d8.gastos' type='number' data-dtype='Number' value='{{jujutsu.props.hitDice.d8.gastos}}' />
                                                <input name='system.props.hitDice.d8.disponiveis' type='number' data-dtype='Number' value='{{jujutsu.props.hitDice.d8.disponiveis}}' />
                                            </div>
                                            <div class='jj-hit-dice-row'>
                                                <span class='jj-hit-dice-die'>d10</span>
                                                <input name='system.props.hitDice.d10.gastos' type='number' data-dtype='Number' value='{{jujutsu.props.hitDice.d10.gastos}}' />
                                                <input name='system.props.hitDice.d10.disponiveis' type='number' data-dtype='Number' value='{{jujutsu.props.hitDice.d10.disponiveis}}' />
                                            </div>
                                            <div class='jj-hit-dice-row'>
                                                <span class='jj-hit-dice-die'>d12</span>
                                                <input name='system.props.hitDice.d12.gastos' type='number' data-dtype='Number' value='{{jujutsu.props.hitDice.d12.gastos}}' />
                                                <input name='system.props.hitDice.d12.disponiveis' type='number' data-dtype='Number' value='{{jujutsu.props.hitDice.d12.disponiveis}}' />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                </div>
            </div>

            <section class='jj-panel' data-tab-block='inventario'>
                <h2>Inventário</h2>
                <div class='jj-inventory-toolbar'>
                    <div class='jj-inventory-space-grid'>
                        <label class='jj-card jj-inventory-space-card'>
                            <span class='jj-inventory-space-label'>Limite de Espaços</span>
                            <input
                                name='system.props.inventory.spaceLimit'
                                type='number'
                                min='0'
                                step='1'
                                data-dtype='Number'
                                value='{{jujutsu.props.inventory.spaceLimit}}'
                            />
                        </label>
                        <div class='jj-card jj-inventory-space-card'>
                            <span class='jj-inventory-space-label'>Espaços Restantes</span>
                            <strong class='jj-inventory-space-value'>{{jujutsu.computed.inventory.spaceRemaining}}</strong>
                        </div>
                        <div class='jj-card jj-inventory-space-card'>
                            <span class='jj-inventory-space-label'>Itens Cadastrados</span>
                            <strong class='jj-inventory-space-value'>{{jujutsu.computed.inventory.usedSpaces}}</strong>
                        </div>
                    </div>
                    <button class='jj-action-button' type='button' data-action='addJujutsuRow' data-table-path='tables.inventory' data-row-type='inventory'>
                        Adicionar item
                    </button>
                </div>
                <div class='jj-card jj-inventory-card'>
                    <table class='jj-inventory-table' data-table-path='tables.inventory'>
                        <colgroup>
                            <col class='jj-inventory-col--item' />
                            <col class='jj-inventory-col--number' />
                            <col class='jj-inventory-col--number' />
                            <col class='jj-inventory-col--number' />
                            <col class='jj-inventory-col--actions' />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Nome do Item</th>
                                <th class='jj-inventory-col--number'>Quant.</th>
                                <th class='jj-inventory-col--number'>Peso</th>
                                <th class='jj-inventory-col--number'>Preço</th>
                                <th class='jj-inventory-col--actions'>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#if jujutsu.props.tables.inventory.length}}
                                {{#each jujutsu.props.tables.inventory as |item|}}
                                    <tr>
                                        <td>
                                            <div
                                                class='jj-inventory-item-main jj-inventory-item-main--draggable'
                                                draggable='true'
                                                data-jujutsu-inventory-drag
                                                data-row-index='{{@index}}'
                                                data-entry-id='{{item.id}}'
                                                title='Arraste para a barra de hotkeys'
                                            >
                                                <img class='jj-inventory-item-image' src='{{item.image}}' alt='{{item.name}}' />
                                                <div class='jj-inventory-item-text'>
                                                    <strong>{{item.name}}</strong>
                                                    {{#if item.hasRoll}}
                                                        <span class='jj-inventory-roll-chip'>{{item.rollLabel}}</span>
                                                    {{/if}}
                                                    {{#if item.equipped}}
                                                        <span class='jj-inventory-roll-chip'>Equipado</span>
                                                    {{/if}}
                                                    {{#if (eq item.itemType 'weapon')}}
                                                        <span class='jj-inventory-roll-chip'>Arma</span>
                                                    {{/if}}
                                                    {{#if (eq item.itemType 'equipment')}}
                                                        <span class='jj-inventory-roll-chip'>Defesa +{{item.defenseBonus}}</span>
                                                    {{/if}}
                                                </div>
                                            </div>
                                        </td>
                                        <td class='jj-inventory-cell--number'>{{item.quantity}}</td>
                                        <td class='jj-inventory-cell--number'>{{item.weight}}</td>
                                        <td class='jj-inventory-cell--number'>{{item.price}}</td>
                                        <td class='jj-inventory-actions-cell' data-table-path='tables.inventory'>
                                            <div class='jj-inventory-actions'>
                                                {{#if item.hasRoll}}
                                                    <button
                                                        type='button'
                                                        class='jj-table-icon-button'
                                                        data-roll-inventory-item
                                                        data-row-index='{{@index}}'
                                                        title='Rolar {{item.rollLabel}}'
                                                    >
                                                        <i class='fas fa-dice-d20'></i>
                                                    </button>
                                                {{else}}
                                                    <span class='jj-table-icon-button jj-table-icon-button--ghost' aria-hidden='true'></span>
                                                {{/if}}
                                                <button
                                                    type='button'
                                                    class='jj-table-icon-button'
                                                    data-action='editJujutsuRow'
                                                    data-table-path='tables.inventory'
                                                    data-row-index='{{@index}}'
                                                    title='Editar item'
                                                >
                                                    <i class='fas fa-pen'></i>
                                                </button>
                                                <button
                                                    type='button'
                                                    class='jj-table-icon-button'
                                                    data-action='removeJujutsuRow'
                                                    data-table-path='tables.inventory'
                                                    data-row-index='{{@index}}'
                                                    title='Excluir item'
                                                >
                                                    <i class='fas fa-trash'></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                {{/each}}
                            {{else}}
                                <tr>
                                    <td colspan='5' class='jj-inventory-empty'>Nenhum item cadastrado no inventário.</td>
                                </tr>
                            {{/if}}
                        </tbody>
                    </table>
                </div>
            </section>

            <section class='jj-panel jj-invocations-panel' data-tab-block='invocacoes'>
                <h2>Invocações</h2>
                <table class='jj-table jj-invocations-table'>
                    <colgroup>
                        <col class='jj-invocation-name-col' />
                        <col class='jj-invocation-stat-col' />
                        <col class='jj-invocation-stat-col' />
                        <col class='jj-invocation-stat-col' />
                        <col class='jj-invocation-stat-col' />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Grau</th>
                            <th>Vida</th>
                            <th>Defesa</th>
                            <th>Desloc.</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#if jujutsu.invocations.length}}
                            {{#each jujutsu.invocations as |invocation|}}
                                <tr class='jj-invocation-summary-row'>
                                    <td class='jj-table-item-cell'>
                                        <div class='jj-table-item'>
                                            <div class='jj-table-item-main'>
                                                <img class='jj-table-item-thumb' src='{{invocation.imageSrc}}' alt='{{invocation.displayName}}' />
                                                <div class='jj-table-item-text'>
                                                    <strong>{{invocation.displayName}}</strong>
                                                    <span>{{invocation.trainedSkills.length}} perícias treinadas</span>
                                                </div>
                                            </div>
                                            <div class='jj-table-item-actions'>
                                                <button class='jj-table-icon-button jj-table-icon-button--danger' type='button' data-action='removeInvocation' data-row-index='{{invocation.rowIndex}}' data-tooltip='Excluir {{invocation.displayName}}' aria-label='Excluir {{invocation.displayName}}'>
                                                    <i class='fas fa-trash'></i>
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                    <td class='jj-invocation-meta-cell'><span class='jj-invocation-meta-value'>{{#if invocation.grau}}{{invocation.grau}}{{else}}-{{/if}}</span></td>
                                    <td class='jj-invocation-meta-cell'><span class='jj-invocation-meta-value'>{{invocation.hpCurrent}} / {{invocation.hpMax}}</span></td>
                                    <td class='jj-invocation-meta-cell'><span class='jj-invocation-meta-value'>{{invocation.defense}}</span></td>
                                    <td class='jj-invocation-meta-cell'><span class='jj-invocation-meta-value'>{{invocation.movementDisplay}}</span></td>
                                </tr>
                                <tr class='jj-invocation-detail-row'>
                                    <td colspan='5' class='jj-invocation-detail-cell'>
                                        <details class='jj-invocation-details' data-invocation-row-index='{{invocation.rowIndex}}' data-invocation-name='{{invocation.displayName}}' data-trained-skills-path='system.props.tables.invocations.{{invocation.rowIndex}}.trainedSkills'>
                                            <summary class='jj-invocation-details-toggle'>Detalhes de {{invocation.displayName}}</summary>
                                            <div class='jj-invocation-details-body'>
                                                <div class='jj-invocation-compact-top'>
                                                    <div class='jj-invocation-visual-frame jj-invocation-visual-frame--compact'>
                                                        <img
                                                            class='jj-invocation-visual'
                                                            src='{{invocation.imageSrc}}'
                                                            data-action='editImage'
                                                            data-field='{{invocation.imageField}}'
                                                            title='{{invocation.displayName}}'
                                                            alt='{{invocation.displayName}}'
                                                        />
                                                    </div>
                                                    <div class='jj-invocation-compact-fields'>
                                                        <label class='jj-derived-row jj-derived-row--wide jj-invocation-field--wide jj-invocation-name-field'>
                                                            <span>Nome</span>
                                                            <input data-invocation-field data-field-path='system.props.tables.invocations.{{invocation.rowIndex}}.name' name='system.props.tables.invocations.{{invocation.rowIndex}}.name' type='text' value='{{invocation.name}}' />
                                                        </label>
                                                        <label class='jj-derived-row jj-invocation-quick-field'>
                                                            <span>PV Atual</span>
                                                            <input data-invocation-field data-field-path='system.props.tables.invocations.{{invocation.rowIndex}}.hpCurrent' name='system.props.tables.invocations.{{invocation.rowIndex}}.hpCurrent' type='number' data-dtype='Number' value='{{invocation.hpCurrent}}' />
                                                        </label>
                                                        <label class='jj-derived-row jj-invocation-quick-field'>
                                                            <span>PV Máx.</span>
                                                            <input data-invocation-field data-field-path='system.props.tables.invocations.{{invocation.rowIndex}}.hpMax' name='system.props.tables.invocations.{{invocation.rowIndex}}.hpMax' type='number' data-dtype='Number' value='{{invocation.hpMax}}' />
                                                        </label>
                                                        <label class='jj-derived-row jj-invocation-quick-field'>
                                                            <span>Defesa</span>
                                                            <input data-invocation-field data-field-path='system.props.tables.invocations.{{invocation.rowIndex}}.defense' name='system.props.tables.invocations.{{invocation.rowIndex}}.defense' type='number' data-dtype='Number' value='{{invocation.defense}}' />
                                                        </label>
                                                        <label class='jj-derived-row jj-invocation-grade-row jj-invocation-quick-field'>
                                                            <span>Grau</span>
                                                            <input data-invocation-field data-field-path='system.props.tables.invocations.{{invocation.rowIndex}}.grau' name='system.props.tables.invocations.{{invocation.rowIndex}}.grau' type='text' value='{{invocation.grau}}' />
                                                        </label>
                                                        <label class='jj-derived-row jj-invocation-quick-field'>
                                                            <span>Desloc.</span>
                                                            <input data-invocation-field data-field-path='system.props.tables.invocations.{{invocation.rowIndex}}.movement' name='system.props.tables.invocations.{{invocation.rowIndex}}.movement' type='text' value='{{invocation.movement}}' />
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class='jj-invocation-compact-grid'>
                                                    <div class='jj-invocation-section jj-invocation-section--attributes'>
                                                        <div class='jj-invocation-section-title'>Atributos</div>
                                                        <table class='jj-table jj-invocation-attribute-table'>
                                                            <thead>
                                                                <tr>
                                                                    <th>Atributo</th>
                                                                    <th>Valor</th>
                                                                    <th>Mod.</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                {{#each invocation.attributeRows as |attribute|}}
                                                                    <tr>
                                                                        <td>{{attribute.label}}</td>
                                                                        <td>
                                                                            <input
                                                                                data-invocation-field
                                                                                data-field-path='system.props.tables.invocations.{{../rowIndex}}.attributes.{{attribute.key}}'
                                                                                name='system.props.tables.invocations.{{../rowIndex}}.attributes.{{attribute.key}}'
                                                                                type='number'
                                                                                data-dtype='Number'
                                                                                value='{{attribute.value}}'
                                                                            />
                                                                        </td>
                                                                        <td>
                                                                            <input type='text' value='{{attribute.signedMod}}' readonly data-invocation-attribute-mod />
                                                                        </td>
                                                                    </tr>
                                                                {{/each}}
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div class='jj-invocation-section jj-invocation-section--actions'>
                                                        <div class='jj-invocation-section-title'>Ações e Características</div>
                                                        <textarea class='jj-invocation-actions' data-invocation-field data-field-path='system.props.tables.invocations.{{invocation.rowIndex}}.acoesCaracteristicas' name='system.props.tables.invocations.{{invocation.rowIndex}}.acoesCaracteristicas' rows='5'>{{invocation.acoesCaracteristicas}}</textarea>
                                                    </div>
                                                </div>
                                                <div class='jj-invocation-section'>
                                                    <div class='jj-invocation-section-title'>Perícias Treinadas</div>
                                                    <table class='jj-table jj-invocation-skill-table'>
                                                        <colgroup>
                                                            <col class='jj-invocation-skill-name-col' />
                                                            <col class='jj-invocation-skill-attribute-col' />
                                                            <col class='jj-invocation-skill-others-col' />
                                                            <col class='jj-invocation-skill-bonus-col' />
                                                        </colgroup>
                                                        <thead>
                                                            <tr>
                                                                <th>Nome</th>
                                                                <th>Atributo</th>
                                                                <th>Outros</th>
                                                                <th>Bônus</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody data-invocation-trained-skills-body>
                                                            {{#if invocation.trainedSkills.length}}
                                                                {{#each invocation.trainedSkills as |skill|}}
                                                                    <tr>
                                                                        <td class='jj-table-item-cell'>
                                                                            <div class='jj-table-item'>
                                                                                <div class='jj-table-item-main'>
                                                                                    <div class='jj-table-item-text'>
                                                                                        <strong>{{skill.name}}</strong>
                                                                                    </div>
                                                                                </div>
                                                                                <div class='jj-table-item-actions'>
                                                                                    <button class='jj-table-icon-button' type='button' data-action='editJujutsuRow' data-table-path='{{../trainedSkillsTablePath}}' data-row-index='{{skill.rowIndex}}' data-tooltip='Editar {{skill.name}}' aria-label='Editar {{skill.name}}'>
                                                                                        <i class='fas fa-pen'></i>
                                                                                    </button>
                                                                                    <button class='jj-table-icon-button jj-table-icon-button--danger' type='button' data-action='removeJujutsuRow' data-table-path='{{../trainedSkillsTablePath}}' data-row-index='{{skill.rowIndex}}' data-tooltip='Excluir {{skill.name}}' aria-label='Excluir {{skill.name}}'>
                                                                                        <i class='fas fa-trash'></i>
                                                                                    </button>
                                                                                </div>
                                                                            </div>
                                                                        </td>
                                                                        <td>{{skill.attributeLabel}}</td>
                                                                        <td>{{skill.others}}</td>
                                                                        <td>{{skill.bonus}}</td>
                                                                    </tr>
                                                                {{/each}}
                                                            {{else}}
                                                                <tr>
                                                                    <td colspan='4' class='jj-inventory-empty'>Nenhuma perícia treinada cadastrada.</td>
                                                                </tr>
                                                            {{/if}}
                                                        </tbody>
                                                    </table>
                                                    <button class='jj-action-button jj-invocation-skill-button' type='button' data-action='addJujutsuRow' data-table-path='{{invocation.trainedSkillsTablePath}}' data-row-type='invocationSkill'>Adicionar perícia treinada</button>
                                                </div>
                                                <div class='jj-invocation-detail-actions'>
                                                    <button class='jj-action-button' type='button' data-action='saveInvocationDetails' data-row-index='{{invocation.rowIndex}}' disabled>Salvar detalhes</button>
                                                </div>
                                            </div>
                                        </details>
                                    </td>
                                </tr>
                            {{/each}}
                        {{else}}
                            <tr>
                                <td colspan='5' class='jj-inventory-empty'>Nenhuma invocação cadastrada.</td>
                            </tr>
                        {{/if}}
                    </tbody>
                </table>
                <button class='jj-action-button' type='button' data-action='createInvocation'>Criar nova invocação</button>
            </section>

            <section class='jj-panel' data-tab-block='aptidoes'>
                <h2>Aptidões Amaldiçoadas</h2>
                <table class='jj-table'>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Atual</th>
                            <th>Max.</th>
                            <th>Custo</th>
                            <th>Rolagem</th>
                            <th>Bônus</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#if jujutsu.props.tables.aptitudes.length}}
                            {{#each jujutsu.props.tables.aptitudes as |aptitude idx|}}
                                <tr>
                                    <td class='jj-table-item-cell'>
                                        <div class='jj-table-item'>
                                            <div
                                                class='jj-table-item-main jj-table-item-main--draggable'
                                                draggable='true'
                                                data-jujutsu-table-drag
                                                data-table-key='aptitudes'
                                                data-row-index='{{idx}}'
                                                data-entry-id='{{aptitude.id}}'
                                                title='Arraste para a barra de hotkeys'
                                            >
                                                <img class='jj-table-item-thumb' src='{{aptitude.image}}' alt='{{aptitude.name}}' />
                                                <div class='jj-table-item-text'>
                                                    <strong>{{aptitude.name}}</strong>
                                                    <span>Atual {{aptitude.current}} / {{aptitude.max}} • Custo {{aptitude.cost}}</span>
                                                </div>
                                            </div>
                                            <div class='jj-table-item-actions'>
                                                <button class='jj-table-icon-button' type='button' data-use-table-feature data-collection='aptitudes' data-row-index='{{idx}}' data-tooltip='Usar {{aptitude.name}}' aria-label='Usar {{aptitude.name}}'>
                                                    <i class='fas fa-dice-d20'></i>
                                                </button>
                                                <button class='jj-table-icon-button' type='button' data-action='editJujutsuRow' data-table-path='tables.aptitudes' data-row-index='{{idx}}' data-tooltip='Editar {{aptitude.name}}' aria-label='Editar {{aptitude.name}}'>
                                                    <i class='fas fa-pen'></i>
                                                </button>
                                                <button class='jj-table-icon-button jj-table-icon-button--danger' type='button' data-action='removeJujutsuRow' data-table-path='tables.aptitudes' data-row-index='{{idx}}' data-tooltip='Excluir {{aptitude.name}}' aria-label='Excluir {{aptitude.name}}'>
                                                    <i class='fas fa-trash'></i>
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                    <td>{{aptitude.current}}</td>
                                    <td>{{aptitude.max}}</td>
                                    <td>{{aptitude.cost}}</td>
                                    <td class='jj-checkbox-cell'>
                                        <input type='hidden' name='system.props.tables.aptitudes.{{idx}}.hasRoll' value='false' />
                                        <label class='jj-checkbox jj-checkbox--compact {{#if aptitude.hasRoll}}is-checked{{/if}}'>
                                            <input class='jj-checkbox-input' name='system.props.tables.aptitudes.{{idx}}.hasRoll' type='checkbox' value='true' data-aptitude-roll-toggle {{checked aptitude.hasRoll}} />
                                            <span class='jj-checkbox-mark' aria-hidden='true'></span>
                                        </label>
                                    </td>
                                    <td>
                                        <input
                                            class='jj-aptitude-roll-bonus-input'
                                            name='system.props.tables.aptitudes.{{idx}}.rollBonus'
                                            type='number'
                                            data-dtype='Number'
                                            step='1'
                                            value='{{aptitude.rollBonus}}'
                                            data-aptitude-roll-bonus
                                            {{#unless aptitude.hasRoll}}disabled{{/unless}}
                                        />
                                    </td>
                                </tr>
                            {{/each}}
                        {{else}}
                            <tr>
                                <td colspan='6' class='jj-inventory-empty'>Nenhuma aptidão cadastrada.</td>
                            </tr>
                        {{/if}}
                    </tbody>
                </table>
                <button class='jj-action-button' type='button' data-action='addJujutsuRow' data-table-path='tables.aptitudes' data-row-type='aptitude'>Adicionar aptidão</button>
            </section>

            <section class='jj-panel' data-tab-block='aptidoes'>
                <h2>Níveis de Aptidão</h2>
                <div class='jj-aptitude-level-grid'>
                    {{#each jujutsu.aptitudeLevelCards as |card|}}
                        <label class='jj-card jj-aptitude-level-card' data-aptitude-level-card data-aptitude-label='{{card.label}}'>
                            <button class='jj-table-icon-button' type='button' data-roll-aptitude-level data-aptitude-key='{{card.key}}' data-tooltip='Rolar {{card.label}}' aria-label='Rolar {{card.label}}'>
                                <i class='fas fa-dice-d20'></i>
                            </button>
                            <input
                                class='jj-aptitude-level-input'
                                name='system.props.aptitudeLevels.{{card.key}}'
                                type='number'
                                min='0'
                                step='1'
                                data-dtype='Number'
                                value='{{card.value}}'
                            />
                            <span>{{card.label}}</span>
                        </label>
                    {{/each}}
                </div>
            </section>

            <section class='jj-panel' data-tab-block='treinamentos'>
                <h2>Treinamentos</h2>
                {{#if jujutsu.trainingCards.length}}
                    <div class='jj-training-board'>
                        {{#each jujutsu.trainingCards as |training|}}
                            <article class='jj-card jj-training-card'>
                                <header class='jj-training-card-header'>
                                    <h3>{{training.label}}</h3>
                                </header>
                                <div class='jj-training-stage-list'>
                                    {{#each training.stages as |stage|}}
                                        <label class='jj-training-stage-row'>
                                            <span>{{stage.label}}</span>
                                            <label class='jj-checkbox jj-checkbox--compact {{#if stage.checked}}is-checked{{/if}}'>
                                                <input
                                                    class='jj-checkbox-input'
                                                    name='system.props.trainingStages.{{training.id}}.{{stage.key}}'
                                                    type='checkbox'
                                                    {{checked stage.checked}}
                                                    aria-label='{{training.label}} - {{stage.label}}'
                                                />
                                                <span class='jj-checkbox-mark' aria-hidden='true'></span>
                                            </label>
                                        </label>
                                    {{/each}}
                                </div>
                                <div class='jj-training-complete {{#if training.isComplete}}is-complete{{/if}}'>
                                    <strong>Treinamento Completo</strong>
                                </div>
                                <p class='jj-training-description'>{{training.description}}</p>
                            </article>
                        {{/each}}
                    </div>
                {{else}}
                    <p class='jj-rd-empty'>Nenhum treinamento ativo para exibição. Configure em Treinamentos.</p>
                {{/if}}
                <div class='jj-card jj-card--rd'>
                    <div class='jj-rd-block jj-trainings-block {{#unless jujutsu.hasActiveTrainings}}is-empty{{/unless}}'>
                        <div class='jj-rd-heading'>
                            {{#if editable}}
                                <button class='jj-rd-config-button' type='button' data-action='configureJujutsuTrainings' data-tooltip='Configurar Treinamentos' aria-label='Configurar Treinamentos'>
                                    <i class='fas fa-cog'></i>
                                </button>
                            {{/if}}
                            <h3>Treinamentos</h3>
                        </div>
                        {{#if jujutsu.hasActiveTrainings}}
                            <ul class='jj-rd-pills jj-trainings-pills'>
                                {{#each jujutsu.activeTrainingDefinitions as |training|}}
                                    <li class='jj-rd-pill jj-training-pill' data-tooltip='{{training.tooltip}}' aria-label='{{training.tooltip}}'>{{training.label}}</li>
                                {{/each}}
                            </ul>
                        {{else}}
                            <p class='jj-rd-empty'>Nenhum treinamento configurado.</p>
                        {{/if}}
                    </div>
                </div>
            </section>

            <section class='jj-panel jj-profile-panel' data-tab-block='perfil-a'>
                <h2>Perfil Amaldiçoado</h2>
                <div class='jj-profile-layout'>
                    <div class='jj-profile-side'>
                        <div class='jj-card jj-derived-card'>
                            <h3>Técnica Amaldiçoada</h3>
                            <div class='jj-derived-body jj-profile-fields'>
                                <label class='jj-profile-field'>
                                    <span>Nome da Técnica</span>
                                    <input name='system.props.perfilAmaldicoado.tecnicaNome' type='text' value='{{jujutsu.props.perfilAmaldicoado.tecnicaNome}}' />
                                </label>
                                <label class='jj-profile-field jj-profile-field--textarea'>
                                    <span>Descrição da Técnica</span>
                                    <textarea name='system.props.perfilAmaldicoado.tecnicaDescricao' rows='10'>{{jujutsu.props.perfilAmaldicoado.tecnicaDescricao}}</textarea>
                                </label>
                            </div>
                        </div>
                        <div class='jj-card jj-derived-card jj-profile-summary-card'>
                            <h3>Perfil Amaldiçoado</h3>
                            <div class='jj-derived-body jj-profile-summary-body'>
                                <label class='jj-derived-row jj-derived-row--wide'>
                                    <span>Feitiços Conhecidos</span>
                                    <input type='number' value='{{jujutsu.computed.perfilAmaldicoado.knownSpells}}' readonly />
                                </label>
                                <label class='jj-derived-row jj-derived-row--wide'>
                                    <span>Atributo Principal</span>
                                    <select name='system.props.perfilAmaldicoado.atributoPrincipal'>
                                        {{#each jujutsu.attributeOptions as |opt|}}
                                            <option value='{{opt.key}}' {{#if (eq opt.key ../jujutsu.props.perfilAmaldicoado.atributoPrincipal)}}selected{{/if}}>{{opt.label}}</option>
                                        {{/each}}
                                    </select>
                                </label>
                                <div class='jj-profile-cd-grid'>
                                    <div class='jj-card jj-derived-card jj-profile-cd-card'>
                                        <h3>CD Técnica</h3>
                                        <div class='jj-derived-body'>
                                            <div class='jj-derived-total'>
                                                <span>Total</span>
                                                <input type='number' value='{{jujutsu.computed.perfilAmaldicoado.cdTecnica.total}}' readonly />
                                            </div>
                                            <div class='jj-derived-fields'>
                                                <label class='jj-derived-row'>
                                                    <span>Atributo {{jujutsu.computed.perfilAmaldicoado.attributeLabel}}</span>
                                                    <input type='number' value='{{jujutsu.computed.perfilAmaldicoado.cdTecnica.attribute}}' readonly />
                                                </label>
                                                <label class='jj-derived-row'>
                                                    <span>Nível/2</span>
                                                    <input type='number' value='{{jujutsu.computed.perfilAmaldicoado.levelHalf}}' readonly />
                                                </label>
                                                <label class='jj-derived-row'>
                                                    <span>Outros</span>
                                                    <input name='system.props.perfilAmaldicoado.cdTecnica.others' type='number' data-dtype='Number' value='{{jujutsu.props.perfilAmaldicoado.cdTecnica.others}}' />
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class='jj-card jj-derived-card jj-profile-cd-card'>
                                        <h3>CD Amaldiçoada</h3>
                                        <div class='jj-derived-body'>
                                            <div class='jj-derived-total'>
                                                <span>Total</span>
                                                <input type='number' value='{{jujutsu.computed.perfilAmaldicoado.cdAmaldicoada.total}}' readonly />
                                            </div>
                                            <div class='jj-derived-fields'>
                                                <label class='jj-derived-row'>
                                                    <span>Atributo {{jujutsu.computed.perfilAmaldicoado.attributeLabel}}</span>
                                                    <input type='number' value='{{jujutsu.computed.perfilAmaldicoado.cdAmaldicoada.attribute}}' readonly />
                                                </label>
                                                <label class='jj-derived-row'>
                                                    <span>Nível/2</span>
                                                    <input type='number' value='{{jujutsu.computed.perfilAmaldicoado.levelHalf}}' readonly />
                                                </label>
                                                <label class='jj-derived-row'>
                                                    <span>Outros</span>
                                                    <input name='system.props.perfilAmaldicoado.cdAmaldicoada.others' type='number' data-dtype='Number' value='{{jujutsu.props.perfilAmaldicoado.cdAmaldicoada.others}}' />
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class='jj-profile-main'>
                        <div class='jj-card jj-derived-card jj-profile-spells-card'>
                            <h3>Lista de Feitiços</h3>
                            <div class='jj-derived-body jj-profile-spells-body'>
                                <div class='jj-profile-spells-toolbar'>
                                    <button class='jj-action-button' type='button' data-action='addJujutsuRow' data-table-path='tables.spells' data-row-type='spell'>Adicionar feitiço</button>
                                </div>
                                <table class='jj-table'>
                                    <thead>
                                        <tr>
                                            <th>Nome</th>
                                            <th>Acerto</th>
                                            <th>Atual</th>
                                            <th>Max.</th>
                                            <th>Custo</th>
                                            <th>Nível</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#if jujutsu.props.tables.spells.length}}
                                            {{#each jujutsu.props.tables.spells as |spell idx|}}
                                                <tr>
                                                    <td class='jj-table-item-cell'>
                                                        <div class='jj-table-item'>
                                                            <div
                                                                class='jj-table-item-main jj-table-item-main--draggable'
                                                                draggable='true'
                                                                data-jujutsu-table-drag
                                                                data-table-key='spells'
                                                                data-row-index='{{idx}}'
                                                                data-entry-id='{{spell.id}}'
                                                                title='Arraste para a barra de hotkeys'
                                                            >
                                                                <img class='jj-table-item-thumb' src='{{spell.image}}' alt='{{spell.name}}' />
                                                                <div class='jj-table-item-text'>
                                                                    <strong>{{spell.name}}</strong>
                                                                    <span>Acerto: {{spell.acerto}} • Nível: {{spell.level}}</span>
                                                                </div>
                                                            </div>
                                                            <div class='jj-table-item-actions'>
                                                                <button class='jj-table-icon-button' type='button' data-use-table-feature data-collection='spells' data-row-index='{{idx}}' data-tooltip='Usar {{spell.name}}' aria-label='Usar {{spell.name}}'>
                                                                    <i class='fas fa-dice-d20'></i>
                                                                </button>
                                                                <button class='jj-table-icon-button' type='button' data-action='editJujutsuRow' data-table-path='tables.spells' data-row-index='{{idx}}' data-tooltip='Editar {{spell.name}}' aria-label='Editar {{spell.name}}'>
                                                                    <i class='fas fa-pen'></i>
                                                                </button>
                                                                <button class='jj-table-icon-button jj-table-icon-button--danger' type='button' data-action='removeJujutsuRow' data-table-path='tables.spells' data-row-index='{{idx}}' data-tooltip='Excluir {{spell.name}}' aria-label='Excluir {{spell.name}}'>
                                                                    <i class='fas fa-trash'></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>{{spell.acerto}}</td>
                                                    <td>{{spell.current}}</td>
                                                    <td>{{spell.max}}</td>
                                                    <td>{{spell.cost}}</td>
                                                    <td>{{spell.level}}</td>
                                                </tr>
                                            {{/each}}
                                        {{else}}
                                            <tr>
                                                <td colspan='6' class='jj-inventory-empty'>Nenhum feitiço cadastrado.</td>
                                            </tr>
                                        {{/if}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class='jj-panel jj-profile-panel' data-tab-block='expansao'>
                <h2>Expansão</h2>
                <div class='jj-profile-bottom-grid'>
                    <div class='jj-card jj-derived-card'>
                        <h3>Expansão de Domínio</h3>
                        <div class='jj-derived-body jj-profile-fields'>
                            <label class='jj-profile-field'>
                                <span>Nome da Expansão</span>
                                <input name='system.props.perfilAmaldicoado.expansaoNome' type='text' value='{{jujutsu.props.perfilAmaldicoado.expansaoNome}}' />
                            </label>
                            <label class='jj-profile-field'>
                                <span>Tipo de Expansão</span>
                                <input name='system.props.perfilAmaldicoado.expansaoTipo' type='text' value='{{jujutsu.props.perfilAmaldicoado.expansaoTipo}}' />
                            </label>
                            <label class='jj-profile-field jj-profile-field--textarea'>
                                <span>Descrição da Expansão</span>
                                <textarea name='system.props.perfilAmaldicoado.expansaoDescricao' rows='10'>{{jujutsu.props.perfilAmaldicoado.expansaoDescricao}}</textarea>
                            </label>
                        </div>
                    </div>
                    <div class='jj-card jj-derived-card'>
                        <h3>Técnica Máxima</h3>
                        <div class='jj-derived-body jj-profile-fields'>
                            <label class='jj-profile-field'>
                                <span>Nome da Técnica</span>
                                <input name='system.props.perfilAmaldicoado.tecnicasMaximas.0.name' type='text' value='{{jujutsu.props.perfilAmaldicoado.tecnicasMaximas.0.name}}' />
                            </label>
                            <label class='jj-profile-field jj-profile-field--textarea'>
                                <span>Descrição da Técnica Máxima</span>
                                <textarea name='system.props.perfilAmaldicoado.tecnicasMaximas.0.description' rows='4'>{{jujutsu.props.perfilAmaldicoado.tecnicasMaximas.0.description}}</textarea>
                            </label>
                            <input name='system.props.perfilAmaldicoado.tecnicasMaximas.0.id' type='hidden' value='{{jujutsu.props.perfilAmaldicoado.tecnicasMaximas.0.id}}' />
                            <input name='system.props.perfilAmaldicoado.tecnicasMaximas.1.id' type='hidden' value='{{jujutsu.props.perfilAmaldicoado.tecnicasMaximas.1.id}}' />
                            <label class='jj-profile-field'>
                                <span>Técnica Extra 1</span>
                                <input name='system.props.perfilAmaldicoado.tecnicasMaximas.1.name' type='text' value='{{jujutsu.props.perfilAmaldicoado.tecnicasMaximas.1.name}}' />
                            </label>
                            <label class='jj-profile-field jj-profile-field--textarea'>
                                <span>Descrição Extra 1</span>
                                <textarea name='system.props.perfilAmaldicoado.tecnicasMaximas.1.description' rows='4'>{{jujutsu.props.perfilAmaldicoado.tecnicasMaximas.1.description}}</textarea>
                            </label>
                            <input name='system.props.perfilAmaldicoado.tecnicasMaximas.2.id' type='hidden' value='{{jujutsu.props.perfilAmaldicoado.tecnicasMaximas.2.id}}' />
                            <label class='jj-profile-field'>
                                <span>Técnica Extra 2</span>
                                <input name='system.props.perfilAmaldicoado.tecnicasMaximas.2.name' type='text' value='{{jujutsu.props.perfilAmaldicoado.tecnicasMaximas.2.name}}' />
                            </label>
                            <label class='jj-profile-field jj-profile-field--textarea'>
                                <span>Descrição Extra 2</span>
                                <textarea name='system.props.perfilAmaldicoado.tecnicasMaximas.2.description' rows='4'>{{jujutsu.props.perfilAmaldicoado.tecnicasMaximas.2.description}}</textarea>
                            </label>
                        </div>
                    </div>
                </div>
            </section>

            <section class='jj-panel jj-registro-panel' data-tab-block='registro'>
                <h2>Registro</h2>
                <div class='jj-registro-layout'>
                    <div class='jj-registro-top-grid'>
                        <div class='jj-card jj-registro-photo-card'>
                            <h3>Aparência</h3>
                            <div class='jj-registro-portrait-frame'>
                                <img
                                    class='jj-registro-portrait'
                                    src='{{#if jujutsu.props.registro.aparencia}}{{jujutsu.props.registro.aparencia}}{{else}}icons/svg/mystery-man.svg{{/if}}'
                                    data-action='editImage'
                                    data-field='system.props.registro.aparencia'
                                    title='{{document.name}}'
                                    alt='{{document.name}}'
                                />
                            </div>
                        </div>
                        <div class='jj-card jj-registro-details-card'>
                            <h3>Dados Pessoais</h3>
                            <div class='jj-registro-quick-fields'>
                                <label class='jj-registro-quick-field'>
                                    <span>Nome</span>
                                    <input name='system.props.registro.nome' type='text' value='{{jujutsu.props.registro.nome}}' />
                                </label>
                                <label class='jj-registro-quick-field'>
                                    <span>Idade</span>
                                    <input name='system.props.registro.idade' type='text' value='{{jujutsu.props.registro.idade}}' />
                                </label>
                                <label class='jj-registro-quick-field'>
                                    <span>Altura</span>
                                    <input name='system.props.registro.altura' type='text' value='{{jujutsu.props.registro.altura}}' />
                                </label>
                                <label class='jj-registro-quick-field'>
                                    <span>Peso</span>
                                    <input name='system.props.registro.peso' type='text' value='{{jujutsu.props.registro.peso}}' />
                                </label>
                                <label class='jj-registro-quick-field'>
                                    <span>Gênero</span>
                                    <input name='system.props.registro.genero' type='text' value='{{jujutsu.props.registro.genero}}' />
                                </label>
                                <label class='jj-registro-quick-field'>
                                    <span>Cabelos</span>
                                    <input name='system.props.registro.cabelos' type='text' value='{{jujutsu.props.registro.cabelos}}' />
                                </label>
                                <label class='jj-registro-quick-field'>
                                    <span>Olhos</span>
                                    <input name='system.props.registro.olhos' type='text' value='{{jujutsu.props.registro.olhos}}' />
                                </label>
                                <label class='jj-registro-quick-field'>
                                    <span>Pele</span>
                                    <input name='system.props.registro.pele' type='text' value='{{jujutsu.props.registro.pele}}' />
                                </label>
                                <label class='jj-registro-quick-field'>
                                    <span>Roupas</span>
                                    <input name='system.props.registro.roupas' type='text' value='{{jujutsu.props.registro.roupas}}' />
                                </label>
                                <label class='jj-registro-quick-field'>
                                    <span>Marca</span>
                                    <input name='system.props.registro.marca' type='text' value='{{jujutsu.props.registro.marca}}' />
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class='jj-registro-sections'>
                        <div class='jj-card jj-registro-text-card'>
                            <h3>Traços de Personalidade</h3>
                            <textarea name='system.props.registro.tracosPersonalidade' rows='4'>{{jujutsu.props.registro.tracosPersonalidade}}</textarea>
                        </div>
                        <div class='jj-card jj-registro-text-card'>
                            <h3>Ideais</h3>
                            <textarea name='system.props.registro.ideais' rows='4'>{{jujutsu.props.registro.ideais}}</textarea>
                        </div>
                        <div class='jj-card jj-registro-text-card'>
                            <h3>Ligações</h3>
                            <textarea name='system.props.registro.ligacoes' rows='4'>{{jujutsu.props.registro.ligacoes}}</textarea>
                        </div>
                        <div class='jj-card jj-registro-text-card'>
                            <h3>Complicações</h3>
                            <textarea name='system.props.registro.complicacoes' rows='4'>{{jujutsu.props.registro.complicacoes}}</textarea>
                        </div>
                        <div class='jj-card jj-registro-text-card'>
                            <h3>Domínio Inato</h3>
                            <textarea name='system.props.registro.dominioInato' rows='4'>{{jujutsu.props.registro.dominioInato}}</textarea>
                        </div>
                    </div>
                </div>
            </section>
        </section>
    </div>

    <div class='custom-system-customHeader' style='display:none;'></div>
    <div class='custom-system-customBody' style='display:none;'></div>
</div>
