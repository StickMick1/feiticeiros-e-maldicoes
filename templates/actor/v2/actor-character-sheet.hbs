<div class='{{cssClass}} custom-system-entity jj-sheet'>
    <header class='jj-header jj-span-2'>
        <div class='jj-hero'>
            <div class='jj-hero-brand'>
                <div class='jj-hero-title'>
                    <div class='jj-kicker'>FEITICEIROS & MALDIÇÕES</div>
                    <input class='jj-hero-name' name='name' type='text' value='{{document.name}}' />
                </div>
                <div class='jj-hero-tags'>
                    <label><span>Jogador</span><input name='system.props.jogador' type='text' value='{{jujutsu.props.jogador}}' /></label>
                    <label><span>Origem</span><input name='system.props.origem' type='text' value='{{jujutsu.props.origem}}' /></label>
                    <label><span>Espec.</span><input name='system.props.especializacao' type='text' value='{{jujutsu.props.especializacao}}' /></label>
                    <label><span>Tecnica</span><input name='system.props.tecnica' type='text' value='{{jujutsu.props.tecnica}}' /></label>
                </div>
            </div>
            <div class='jj-hero-meta'>
                <div class='jj-hero-badges jj-hero-badges--text'>
                    <label class='jj-badge'>
                        <span>Campanha</span>
                        <input name='system.props.campanha' type='text' value='{{jujutsu.props.campanha}}' />
                    </label>
                    <label class='jj-badge'>
                        <span>Grau</span>
                        <input name='system.props.grau' type='text' value='{{jujutsu.props.grau}}' />
                    </label>
                    <label class='jj-badge'>
                        <span>Experiencia</span>
                        <input name='system.props.experiencia' type='text' value='{{jujutsu.props.experiencia}}' />
                    </label>
                </div>
                <div class='jj-hero-badges jj-hero-badges--number'>
                    <label class='jj-badge jj-badge--number'>
                        <span>Nivel</span>
                        <input name='system.props.level' type='number' data-dtype='Number' value='{{jujutsu.props.level}}' />
                    </label>
                    <label class='jj-badge jj-badge--number'>
                        <span>Treina.</span>
                        <input name='system.props.treinamento' type='number' data-dtype='Number' value='{{jujutsu.computed.trainingBonus}}' data-training-bonus-input readonly />
                    </label>
                </div>
            </div>
        </div>
        <nav class='jj-page-nav' role='tablist' aria-label='Navegacao da ficha'>
            <button class='jj-tab is-active' type='button' role='tab' data-tab-target='resumo' aria-selected='true'>Resumo</button>
            <button class='jj-tab' type='button' role='tab' data-tab-target='pericias' aria-selected='false'>Pericias</button>
            <button class='jj-tab' type='button' role='tab' data-tab-target='habilidades' aria-selected='false'>Habilidades</button>
            <button class='jj-tab' type='button' role='tab' data-tab-target='invocacoes' aria-selected='false'>Invocações</button>
            <button class='jj-tab' type='button' role='tab' data-tab-target='aptidoes' aria-selected='false'>Aptidões</button>
            <button class='jj-tab' type='button' role='tab' data-tab-target='treinamentos' aria-selected='false'>Treinamentos</button>
            <button class='jj-tab' type='button' role='tab' data-tab-target='perfil-a' aria-selected='false'>Perfil A.</button>
            <button class='jj-tab' type='button' role='tab' data-tab-target='expansao' aria-selected='false'>Expansão</button>
            <button class='jj-tab' type='button' role='tab' data-tab-target='inventario' aria-selected='false'>Inventário</button>
            <button class='jj-tab' type='button' role='tab' data-tab-target='registro' aria-selected='false'>Registro</button>
        </nav>
    </header>

    <div class='jj-layout jj-span-2 is-resumo'>
        <aside class='jj-sidebar'>
                    <section class='jj-panel jj-panel--sidebar jj-character-panel' data-tab-block='resumo'>
                        <h2>{{document.name}}</h2>
                <div class='jj-character-card'>
                    <div class='jj-portrait-shell'>
                        <div class='jj-portrait-frame'>
                            <img class='jj-portrait' src='{{document.img}}' data-action='editImage' data-field='img' title='{{document.name}}' />
                        </div>
                        <div class='jj-portrait-badge'>
                            <span>{{jujutsu.props.level}}</span>
                        </div>
                    </div>
                    <div class='jj-lozenges'>
                        <div class='jj-lozenge'>
                            <div class='jj-lozenge-value'>{{jujutsu.computed.initiativeTotal}}</div>
                            <div class='jj-lozenge-label'>Iniciativa</div>
                        </div>
                        <div class='jj-lozenge'>
                            {{#if editable}}
                            <button
                                type='button'
                                class='jj-lozenge-value jj-lozenge-value--button'
                                data-action='configureJujutsuMovement'
                                data-tooltip='Editar deslocamento'
                                aria-label='Editar deslocamento'
                            >{{jujutsu.computed.movement.display}}</button>
                            {{else}}
                            <div class='jj-lozenge-value'>{{jujutsu.computed.movement.display}}</div>
                            {{/if}}
                            <div class='jj-lozenge-label'>Desloc.</div>
                        </div>
                        <div class='jj-lozenge'>
                            <div class='jj-lozenge-value' data-training-bonus-display>+{{jujutsu.computed.trainingBonus}}</div>
                            <div class='jj-lozenge-label'>Treino</div>
                        </div>
                    </div>
                </div>
                <div class='jj-resource jj-resource--vida'>
                    <div class='jj-resource-top'>
                        <strong>Pontos de Vida</strong>
                    </div>
                    <div class='jj-resource-bar'>
                        <span class='jj-resource-fill' style='width: {{jujutsu.computed.resources.vida.percent}}%;'></span>
                        <span class='jj-resource-extra' style='left: {{jujutsu.computed.resources.vida.percent}}%; width: {{jujutsu.computed.resources.vida.extraPercent}}%;'></span>
                        {{#if jujutsu.computed.resources.vida.extra}}
                            <span class='jj-resource-extra-label'>+{{jujutsu.computed.resources.vida.extra}}</span>
                        {{/if}}
                        <div class='jj-resource-values'>
                            <div class='jj-resource-values-inner'>
                                <input name='system.props.resources.vida.atuais' type='number' data-dtype='Number' value='{{jujutsu.props.resources.vida.atuais}}' />
                                <span>/</span>
                                <input name='system.props.resources.vida.maximos' type='number' data-dtype='Number' value='{{jujutsu.props.resources.vida.maximos}}' />
                            </div>
                        </div>
                    </div>
                </div>
                <div class='jj-resource jj-resource--energia'>
                    <div class='jj-resource-top'>
                        <strong>Pontos de Energia</strong>
                    </div>
                    <div class='jj-resource-bar'>
                        <span class='jj-resource-fill' style='width: {{jujutsu.computed.resources.energia.percent}}%;'></span>
                        <span class='jj-resource-extra' style='left: {{jujutsu.computed.resources.energia.percent}}%; width: {{jujutsu.computed.resources.energia.extraPercent}}%;'></span>
                        {{#if jujutsu.computed.resources.energia.extra}}
                            <span class='jj-resource-extra-label'>+{{jujutsu.computed.resources.energia.extra}}</span>
                        {{/if}}
                        <div class='jj-resource-values'>
                            <div class='jj-resource-values-inner'>
                                <input name='system.props.resources.energia.atuais' type='number' data-dtype='Number' value='{{jujutsu.props.resources.energia.atuais}}' />
                                <span>/</span>
                                <input name='system.props.resources.energia.maximos' type='number' data-dtype='Number' value='{{jujutsu.props.resources.energia.maximos}}' />
                            </div>
                        </div>
                    </div>
                </div>
                <div class='jj-resource jj-resource--integridade'>
                    <div class='jj-resource-top'>
                        <strong>Integridade</strong>
                    </div>
                    <div class='jj-resource-bar'>
                        <span class='jj-resource-fill' style='width: {{jujutsu.computed.resources.integridade.percent}}%;'></span>
                        <span class='jj-resource-extra' style='left: {{jujutsu.computed.resources.integridade.percent}}%; width: {{jujutsu.computed.resources.integridade.extraPercent}}%;'></span>
                        {{#if jujutsu.computed.resources.integridade.extra}}
                            <span class='jj-resource-extra-label'>+{{jujutsu.computed.resources.integridade.extra}}</span>
                        {{/if}}
                        <div class='jj-resource-values'>
                            <div class='jj-resource-values-inner'>
                                <input name='system.props.resources.integridade.atual' type='number' data-dtype='Number' value='{{jujutsu.props.resources.integridade.atual}}' />
                                <span>/</span>
                                <input name='system.props.resources.integridade.maxima' type='number' data-dtype='Number' value='{{jujutsu.props.resources.integridade.maxima}}' />
                            </div>
                        </div>
                    </div>
                </div>
                <input type='hidden' name='system.props.resources.vida.perdidos' value='{{jujutsu.computed.resources.vida.lost}}' />
                <input type='hidden' name='system.props.resources.energia.perdidos' value='{{jujutsu.computed.resources.energia.lost}}' />
                <input type='hidden' name='system.props.resources.integridade.perdidos' value='{{jujutsu.computed.resources.integridade.lost}}' />
                <div class='jj-character-status'>
                    <h3>Condição</h3>
                    <div class='jj-character-condition-list'>
                        <label class='jj-character-condition jj-checkbox {{#if jujutsu.props.extra.robustez}}is-checked{{/if}}'>
                            <input class='jj-checkbox-input' name='system.props.extra.robustez' type='checkbox' {{checked jujutsu.props.extra.robustez}} />
                            <span class='jj-checkbox-mark' aria-hidden='true'></span>
                            <span class='jj-checkbox-label'>Robustez</span>
                        </label>
                        <label class='jj-character-condition jj-checkbox {{#if jujutsu.props.extra.desExa}}is-checked{{/if}}' data-tooltip='Desenvolvimento Exagerado de Feto Amaldiçoado' aria-label='Desenvolvimento Exagerado de Feto Amaldiçoado'>
                            <input class='jj-checkbox-input' name='system.props.extra.desExa' type='checkbox' {{checked jujutsu.props.extra.desExa}} />
                            <span class='jj-checkbox-mark' aria-hidden='true'></span>
                            <span class='jj-checkbox-label'>Des. Exa.</span>
                        </label>
                        <label class='jj-character-condition jj-checkbox {{#if jujutsu.props.extra.vigorInf}}is-checked{{/if}}' data-tooltip='Vigor Infindável de Restringido' aria-label='Vigor Infindável de Restringido'>
                            <input class='jj-checkbox-input' name='system.props.extra.vigorInf' type='checkbox' {{checked jujutsu.props.extra.vigorInf}} />
                            <span class='jj-checkbox-mark' aria-hidden='true'></span>
                            <span class='jj-checkbox-label'>Vigor INF</span>
                        </label>
                        <label class='jj-character-condition jj-checkbox {{#if jujutsu.props.extra.kamo}}is-checked{{/if}}'>
                            <input class='jj-checkbox-input' name='system.props.extra.kamo' type='checkbox' {{checked jujutsu.props.extra.kamo}} />
                            <span class='jj-checkbox-mark' aria-hidden='true'></span>
                            <span class='jj-checkbox-label'>Kamo</span>
                        </label>
                    </div>
                    <div class='jj-character-status-fields'>
                        <label class='jj-character-status-field'>
                            <span>Outros</span>
                            <input name='system.props.extra.outros' type='number' data-dtype='Number' value='{{jujutsu.props.extra.outros}}' />
                        </label>
                    </div>
                </div>
            </section>
            <section class='jj-panel jj-saving-throws-panel' data-tab-block='resumo'>
                <h2>Testes de Resistência</h2>
                <table class='jj-table jj-table--saving-throws'>
                    <colgroup>
                        <col class='jj-save-name-col' />
                        <col class='jj-save-bonus-col' />
                        <col class='jj-save-check-col' />
                        <col class='jj-save-check-col' />
                        <col class='jj-save-total-col' />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Teste</th>
                            <th>Outros</th>
                            <th>T</th>
                            <th>M</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each jujutsu.savingThrows as |save|}}
                            <tr data-save-row data-save-key='{{save.key}}' data-save-attribute='{{save.attribute}}' data-save-label='{{save.label}}'>
                                <td class='jj-save-name-cell'>
                                    <div class='jj-save-name'>
                                        <button
                                            class='jj-save-roll-button'
                                            type='button'
                                            data-roll-saving-throw
                                            data-save-key='{{save.key}}'
                                            data-tooltip='Rolar {{save.label}}'
                                            aria-label='Rolar {{save.label}}'
                                        >
                                            <i class='fas fa-dice-d20'></i>
                                        </button>
                                        <span>{{save.label}}</span>
                                    </div>
                                </td>
                                <td class='jj-save-others-cell'><input name='system.props.savingThrows.{{save.key}}.others' type='number' data-dtype='Number' value='{{save.others}}' data-save-others /></td>
                                <td class='jj-checkbox-cell'>
                                    <label class='jj-checkbox jj-checkbox--compact {{#if save.t}}is-checked{{/if}}'>
                                        <input class='jj-checkbox-input' name='system.props.savingThrows.{{save.key}}.t' type='checkbox' data-save-trained {{checked save.t}} />
                                        <span class='jj-checkbox-mark' aria-hidden='true'></span>
                                    </label>
                                </td>
                                <td class='jj-checkbox-cell'>
                                    <label class='jj-checkbox jj-checkbox--compact {{#if save.m}}is-checked{{/if}}'>
                                        <input class='jj-checkbox-input' name='system.props.savingThrows.{{save.key}}.m' type='checkbox' data-save-master {{checked save.m}} />
                                        <span class='jj-checkbox-mark' aria-hidden='true'></span>
                                    </label>
                                </td>
                                <td class='jj-save-total-cell'><input type='number' value='{{save.total}}' data-save-total readonly /></td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </section>

        </aside>

        <section class='jj-main-shell'>
            <section class='jj-panel jj-attributes-panel' data-tab-block='resumo'>
                <h2>Atributos</h2>
                <div class='jj-abilities'>
                    {{#each jujutsu.attributes as |attribute|}}
                                <div class='jj-ability-card' data-ability-card>
                                    <h3>
                                        <button class='jj-attack-roll-button' type='button' data-roll-attribute data-attribute-key='{{attribute.key}}' data-tooltip='Rolar {{attribute.label}}' aria-label='Rolar {{attribute.label}}'>
                                            <i class='fas fa-dice-d20'></i>
                                        </button>
                                        <span>{{attribute.label}}</span>
                                    </h3>
                                    <input class='jj-ability-score' aria-label='Valor' name='system.props.attributes.{{attribute.key}}.value' type='number' data-dtype='Number' value='{{attribute.value}}' data-ability-value />
                                    <input class='jj-ability-mod' aria-label='Modificador' type='text' value='{{attribute.signedMod}}' readonly tabindex='-1' data-ability-mod-display />
                                    <input name='system.props.attributes.{{attribute.key}}.mod' type='hidden' data-dtype='Number' value='{{attribute.mod}}' data-ability-mod-hidden />
                                </div>
                    {{/each}}
                </div>
            </section>

                    <div class='jj-main-columns'>
                        <div class='jj-main-primary'>
                            <section class='jj-panel' data-tab-block='resumo'>
                                <h2>Combate</h2>
                                <div class='jj-combat-summary-grid'>
                                    {{#each jujutsu.attackBonuses as |attack|}}
                                        <div
                                            class='jj-card jj-derived-card jj-attack-card'
                                            data-attack-card
                                            data-attack-key='{{attack.key}}'
                                            data-attack-attribute='{{attack.attribute}}'
                                            data-attack-label='{{attack.label}}'
                                            data-attack-always-trained='{{#if attack.alwaysTrained}}true{{else}}false{{/if}}'
                                        >
                                            <h3 class='jj-attack-card-heading'>
                                                <button
                                                    class='jj-attack-roll-button'
                                                    type='button'
                                                    data-roll-attack
                                                    data-attack-key='{{attack.key}}'
                                                    data-tooltip='Rolar {{attack.label}}'
                                                    aria-label='Rolar {{attack.label}}'
                                                >
                                                    <i class='fas fa-dice-d20'></i>
                                                </button>
                                                <span>{{attack.label}}</span>
                                            </h3>
                                            <div class='jj-derived-body'>
                                                <div class='jj-derived-total'>
                                                    <span>Total</span>
                                                    <input type='number' value='{{attack.total}}' data-attack-total readonly />
                                                </div>
                                                <div class='jj-derived-fields'>
                                                    <label class='jj-derived-row'>
                                                        <span>Treino</span>
                                                        <input type='number' value='{{attack.proficiencyBonus}}' data-attack-training-bonus readonly />
                                                    </label>
                                                    <div class='jj-derived-row jj-derived-row--checkbox'>
                                                        <span>Treinado</span>
                                                        <label class='jj-checkbox jj-checkbox--compact {{#if attack.t}}is-checked{{/if}} {{#if attack.alwaysTrained}}is-disabled{{/if}}' {{#if attack.alwaysTrained}}data-tooltip='Sempre treinado no sistema base' aria-label='Sempre treinado no sistema base'{{/if}}>
                                                            <input class='jj-checkbox-input' name='system.props.attackBonuses.{{attack.key}}.t' type='checkbox' data-attack-trained {{checked attack.t}} />
                                                            <span class='jj-checkbox-mark' aria-hidden='true'></span>
                                                        </label>
                                                    </div>
                                                    <label class='jj-derived-row'>
                                                        <span>Atributo</span>
                                                        <select name='system.props.attackBonuses.{{attack.key}}.attribute' data-attack-attribute-input>
                                                            {{#each ../jujutsu.attributeOptions as |opt|}}
                                                                <option value='{{opt.key}}' {{#if (eq opt.key attack.attribute)}}selected{{/if}}>{{opt.label}}</option>
                                                            {{/each}}
                                                        </select>
                                                    </label>
                                                    <label class='jj-derived-row'>
                                                        <span>Mod. Atr.</span>
                                                        <input type='number' value='{{attack.attributeMod}}' data-attack-attribute-mod readonly />
                                                    </label>
                                                    <label class='jj-derived-row'>
                                                        <span>Nível/2</span>
                                                        <input type='number' value='{{attack.levelHalf}}' data-attack-level-half readonly />
                                                    </label>
                                                    <label class='jj-derived-row'>
                                                        <span>Outros</span>
                                                        <input name='system.props.attackBonuses.{{attack.key}}.others' type='number' data-dtype='Number' value='{{attack.others}}' data-attack-others />
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    {{/each}}
                                </div>
                            </section>
                            <section class='jj-panel' data-tab-block='resumo'>
                                <h2>Informações</h2>
                                <div class='jj-card jj-card--rd'>
                                    <div class='jj-rd-block {{#unless jujutsu.hasActiveRds}}is-empty{{/unless}}'>
                                        <div class='jj-rd-heading'>
                                            {{#if editable}}
                                                <button
                                                    class='jj-rd-config-button'
                                                    type='button'
                                                    data-action='configureJujutsuRds'
                                                    data-tooltip='Configurar Redução de Danos (RDs)'
                                                    aria-label='Configurar Redução de Danos (RDs)'
                                                >
                                                    <i class='fas fa-cog'></i>
                                                </button>
                                            {{/if}}
                                            <h3>Redução de Danos (RDs)</h3>
                                        </div>
                                        {{#if jujutsu.hasActiveRds}}
                                            <ul class='jj-rd-pills'>
                                                {{#each jujutsu.activeRdValues as |rd|}}
                                                    <li class='jj-rd-pill' data-tooltip='{{rd.tooltip}}' aria-label='{{rd.tooltip}}'>{{rd.code}}</li>
                                                {{/each}}
                                            </ul>
                                        {{else}}
                                            <p class='jj-rd-empty'>Nenhuma redução configurada.</p>
                                        {{/if}}
                                    </div>
                                </div>
                                <div class='jj-card jj-card--rd'>
                                    <div class='jj-rd-block jj-resistances-block {{#unless jujutsu.hasActiveResistances}}is-empty{{/unless}}'>
                                        <div class='jj-rd-heading'>
                                            {{#if editable}}
                                                <button
                                                    class='jj-rd-config-button'
                                                    type='button'
                                                    data-action='configureJujutsuResistances'
                                                    data-tooltip='Configurar Resistências'
                                                    aria-label='Configurar Resistências'
                                                >
                                                    <i class='fas fa-cog'></i>
                                                </button>
                                            {{/if}}
                                            <h3>Resistências</h3>
                                        </div>
                                        {{#if jujutsu.hasActiveResistances}}
                                            <ul class='jj-rd-pills jj-resistances-pills'>
                                                {{#each jujutsu.activeResistanceDefinitions as |resistance|}}
                                                    <li class='jj-rd-pill jj-resistance-pill' data-tooltip='{{resistance.tooltip}}' aria-label='{{resistance.tooltip}}'>{{resistance.label}}</li>
                                                {{/each}}
                                            </ul>
                                        {{else}}
                                            <p class='jj-rd-empty'>Nenhuma resistência configurada.</p>
                                        {{/if}}
                                    </div>
                                </div>
                                <div class='jj-card jj-card--rd'>
                                    <div class='jj-rd-block jj-trainings-block {{#unless jujutsu.hasActiveTrainings}}is-empty{{/unless}}'>
                                        <div class='jj-rd-heading'>
                                            {{#if editable}}
                                                <button
                                                    class='jj-rd-config-button'
                                                    type='button'
                                                    data-action='configureJujutsuTrainings'
                                                    data-tooltip='Configurar Treinamentos'
                                                    aria-label='Configurar Treinamentos'
                                                >
                                                    <i class='fas fa-cog'></i>
                                                </button>
                                            {{/if}}
                                            <h3>Treinamentos</h3>
                                        </div>
                                        {{#if jujutsu.hasActiveTrainings}}
                                            <ul class='jj-rd-pills jj-trainings-pills'>
                                                {{#each jujutsu.activeTrainingDefinitions as |training|}}
                                                    <li class='jj-rd-pill jj-training-pill' data-tooltip='{{training.tooltip}}' aria-label='{{training.tooltip}}'>{{training.label}}</li>
                                                {{/each}}
                                            </ul>
                                        {{else}}
                                            <p class='jj-rd-empty'>Nenhum treinamento configurado.</p>
                                        {{/if}}
                                    </div>
                                </div>
                                <div class='jj-card jj-card--rd'>
                                    <div class='jj-rd-block jj-characteristics-block {{#unless jujutsu.hasActiveCharacteristics}}is-empty{{/unless}}'>
                                        <div class='jj-rd-heading'>
                                            {{#if editable}}
                                                <button
                                                    class='jj-rd-config-button'
                                                    type='button'
                                                    data-action='configureJujutsuCharacteristics'
                                                    data-tooltip='Configurar Características'
                                                    aria-label='Configurar Características'
                                                >
                                                    <i class='fas fa-cog'></i>
                                                </button>
                                            {{/if}}
                                            <h3>Características</h3>
                                        </div>
                                        {{#if jujutsu.hasActiveCharacteristics}}
                                            <ul class='jj-rd-pills jj-characteristics-pills'>
                                                {{#each jujutsu.activeCharacteristics as |characteristic|}}
                                                    <li class='jj-rd-pill jj-characteristic-pill {{#if characteristic.isCustom}}is-custom{{/if}}' data-tooltip='{{characteristic.tooltip}}' aria-label='{{characteristic.tooltip}}'>{{characteristic.nome}}</li>
                                                {{/each}}
                                            </ul>
                                        {{else}}
                                            <p class='jj-rd-empty'>Nenhuma característica selecionada.</p>
                                        {{/if}}
                                    </div>
                                </div>
                            </section>
                    <section class='jj-panel' id='jj-pericias' data-tab-block='pericias'>
                        <h2>Pericias</h2>
                        <div class='jj-skills-columns'>
                            {{#each jujutsu.skillColumns as |columnSkills|}}
                                <div class='jj-skills-column'>
                                    <table class='jj-table jj-table--skills'>
                                        <colgroup>
                                            <col class='jj-skill-name-col' />
                                            <col class='jj-skill-attribute-col' />
